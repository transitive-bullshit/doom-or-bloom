# Live Jev evaluation requires this server-side secret. Store it in .env.development.local.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Participant Jev spend budgets in USD (defaults 150 per UTC month, 50 per UTC day).
# Raising one is a deliberate change plus redeploy; 0 pauses Jev calls.
JEV_MONTHLY_BUDGET_USD=
JEV_DAILY_BUDGET_USD=
# Development persona simulations only; participant assessments never use OpenAI.
OPENAI_API_KEY=
# Fixture mode is explicit, local/test only, and labeled in the UI.
ASSESSMENT_PROVIDER=live
NEXT_PUBLIC_ASSESSMENT_DEBUG=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Set true only after configuring Settings > Project > General > discard IP data.
POSTHOG_IP_DISPOSAL_CONFIRMED=false

# Native local Postgres.app databases; never point development/tests at Neon.
DATABASE_URL=postgresql://doom_bloom_dev@localhost:5432/doom_bloom_dev
# Optional direct connection for migrations (defaults to DATABASE_URL).
DATABASE_MIGRATION_URL=
TEST_DATABASE_URL=postgresql://doom_bloom_test@localhost:5432/doom_bloom_test
# Resolve the exact origin with: pnpm exec portless get doom-or-bloom --no-worktree
BETTER_AUTH_URL=http://doom-or-bloom.localhost:1355
# Generate locally with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Optional X OAuth 2.0 Web App. No account is needed to take/share an assessment.
# Callback: ${BETTER_AUTH_URL}/api/auth/callback/twitter
X_CLIENT_ID=
X_CLIENT_SECRET=

# Use these same variable names in ignored .env.production.local for production values.
# Do not copy local database URLs or fixture mode into production.
