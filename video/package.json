{
  "name": "doom-or-bloom-launch-video",
  "version": "0.0.0",
  "private": true,
  "description": "Launch video for Doom or Bloom: a custom Canvas2D + WebGL2 motion engine with deterministic frame capture.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=chrome120 --outfile=dist/main.js --sourcemap",
    "still": "pnpm build && node scripts/still.mjs",
    "render": "pnpm build && node scripts/render.mjs",
    "preview": "pnpm build && node scripts/server.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright-core": "1.63.0"
  }
}
