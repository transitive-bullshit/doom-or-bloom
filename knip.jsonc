{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Standalone development tools and subprocess fixtures are entry points.
  "entry": [
    "scripts/*.ts",
    "tests/browser/*-engine.ts",
    "tests/fixtures/journey-browser-data.ts",
    "tests/browser/*.spec.ts",
    "playwright.config.ts",
    "playwright.analytics.config.ts",
    "tests/analytics/*.spec.ts",
    "tests/browser/persist-engine-response.ts",
    "tests/browser/seed-assessment.ts",
    "auth.schema.config.ts",
    "drizzle.studio.config.ts",
    "playwright.persistence.config.ts",
    "playwright.prefetch.config.ts",
    "tests/prefetch/*.spec.ts",
    "playwright.public-cache.config.ts",
    "tests/public-cache/*.spec.ts",
    "tests/persistence/*.spec.ts"
  ],
  // Analyze browser entries without executing environment-dependent configs.
  "playwright": false,
  // The launch video is a standalone package with its own toolchain.
  "ignore": ["video/**"],
  // Authenticated, externally installed read-only X CLI used by the refresh tool.
  "ignoreBinaries": ["xurl"],
  // Keep the reusable UI primitive APIs while still checking their dependencies.
  "ignoreIssues": {
    "components/ui/**": ["exports", "types"]
  }
}
